# Copy to .env.local and fill in. Never commit .env.local.
# Google Cloud setup: enable the Google Sheets API and the Google Picker API;
# add http://localhost:5173 as an authorized JavaScript origin on the OAuth client.

# OAuth 2.0 client ID (Web application). Scope used: drive.file only.
VITE_GOOGLE_CLIENT_ID=
# API key for the Picker only. Restrict it to the Picker API and your origins.
# Sheets requests use the OAuth token alone; this key is never sent to them.
VITE_GOOGLE_API_KEY=
# Cloud project number (Picker setAppId), so picked files are granted to this app.
VITE_GOOGLE_APP_ID=

# Storage choices to offer, comma-separated: demo, csv, google (all when unset).
# Google also needs the three values above, or it's left out.
# The hosted demo uses .env.dreamhost (npm run deploy): demo,csv.
# VITE_STORAGE_OPTIONS=demo,csv,google
