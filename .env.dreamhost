# The hosted demo (jtracker.fredtranfield.com): npm run deploy builds with this.
# Sample data in the browser and CSV files; no Google Sheets.
VITE_STORAGE_OPTIONS=demo,csv
# Blank on purpose: .env.local is read in every mode, and these override it,
# so the hosted build carries no Google client ID or API key.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
